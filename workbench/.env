# Environment for the workbench demo app.
#
# Every `vendor/bin/testbench` invocation copies this file into the Testbench
# skeleton as `.env`, and the copy routinely outlives the command that made it.
# The package test suite boots against that same skeleton, so these values have
# to be safe for `composer test` as well as for the demo. CACHE_STORE in
# particular stays on `array`: without this file Testbench falls back to the
# framework's own `.env.example`, which selects `database`, and the suite has no
# `cache_locks` table to lock against.
#
# `composer clear` removes the stranded copy.

APP_ENV=workbench
APP_DEBUG=true

DB_CONNECTION=sqlite

QUEUE_CONNECTION=database

CACHE_STORE=array
SESSION_DRIVER=array
MAIL_MAILER=log
